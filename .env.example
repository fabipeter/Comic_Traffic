# ============================================================================
# Comic Traffic — Production Environment Variables Configuration Template
# ============================================================================
#
# ARCHITECTURE OVERVIEW:
# 1. Supabase: Managed PostgreSQL Database (Session mode / Direct port 5432)
# 2. Container Host (Railway / Render / Fly / Cloud Run): .NET 10 Web API
# 3. Vercel: React/Vite Frontend + Serverless API Gateway (/api/gateway.js)
# ============================================================================

# ----------------------------------------------------------------------------
# 1. VERCEL ENVIRONMENT VARIABLES (Vercel Project -> Settings -> Environment Variables)
# ----------------------------------------------------------------------------
# Deployed .NET API HTTPS base URL (proxies auth, reviews, dashboard, watchlist)
BACKEND_API_URL=https://your-backend-api.up.railway.app

# Shared secret between Vercel Serverless Gateway and .NET API (min 24 characters)
GATEWAY_SHARED_SECRET=generate_random_32_char_hex_or_alphanumeric_secret

# End-to-End AES-256-GCM + HMAC-SHA256 Encryption Keys (must match backend)
PAYLOAD_ENCRYPTION_KEY=replace_with_32_byte_aes_secret_here
PAYLOAD_HMAC_KEY=replace_with_32_byte_hmac_secret_here

# External Media APIs (used server-side by /api/gateway.js & /api/_liveSearch.js)
TMDB_API_KEY=your_tmdb_api_key_here
OMDB_API_KEY=your_omdb_api_key_here
MDBLIST_API_KEY=your_mdblist_api_key_here
COMICVINE_API_KEY=your_comicvine_api_key_here
HARDCOVER_API_TOKEN=your_hardcover_api_token_here
GOOGLE_BOOKS_API_KEY=your_google_books_api_key_here

# SendGrid Production Email Delivery
SENDGRID_API_KEY=SG.your_sendgrid_api_key_here
SENDGRID_SENDER_EMAIL=noreply@comictraffic.com
SENDGRID_SENDER_NAME="Comic Traffic"
APP_BASE_URL=https://comictraffic.com

# ----------------------------------------------------------------------------
# 2. .NET BACKEND CONTAINER VARIABLES (Railway / Render / Fly / Cloud Run)
# ----------------------------------------------------------------------------
# Supabase PostgreSQL URI (Use Session mode / Direct connection port 5432)
DATABASE_URL=postgresql://postgres.yourprojectref:your_supabase_db_password@aws-0-eu-central-1.pooler.supabase.com:5432/postgres?sslmode=require

# JWT Token Signing Key (min 32 characters)
JWT_SIGNING_KEY=replace_with_32_byte_jwt_signing_secret_here

# Gateway Shared Secret (must match Vercel GATEWAY_SHARED_SECRET)
GATEWAY_SHARED_SECRET=generate_random_32_char_hex_or_alphanumeric_secret

# Encryption Keys (must match Vercel PAYLOAD_ENCRYPTION_KEY & PAYLOAD_HMAC_KEY)
PAYLOAD_ENCRYPTION_KEY=replace_with_32_byte_aes_secret_here
PAYLOAD_HMAC_KEY=replace_with_32_byte_hmac_secret_here

# CORS Allowed Origins
CORS_ALLOWED_ORIGINS=https://comictraffic.com,https://www.comictraffic.com

# External Media APIs for .NET Backend (LiveMediaSearchService)
TMDB_API_KEY=your_tmdb_api_key_here
OMDB_API_KEY=your_omdb_api_key_here
MDBLIST_API_KEY=your_mdblist_api_key_here
COMICVINE_API_KEY=your_comicvine_api_key_here
HARDCOVER_API_TOKEN=your_hardcover_api_token_here
GOOGLE_BOOKS_API_KEY=your_google_books_api_key_here

# SendGrid Email Delivery for .NET Backend
SENDGRID_API_KEY=SG.your_sendgrid_api_key_here
SENDGRID_SENDER_EMAIL=noreply@comictraffic.com
SENDGRID_SENDER_NAME="Comic Traffic"
APP_BASE_URL=https://comictraffic.com

# Environment
ASPNETCORE_ENVIRONMENT=Production
# PORT is assigned automatically by Railway / Render / Fly
