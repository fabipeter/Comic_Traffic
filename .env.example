# ============================================================================
# Comic Traffic — Server-Side Environment Variables Template (Safe for GitHub)
# All API keys, encryption keys, and database credentials live strictly on the
# backend / Vercel Serverless environment — ZERO frontend REACT_APP_ keys.
# ============================================================================

# Google Cloud SQL for PostgreSQL Connection String
DATABASE_URL=postgresql://ct_app_user:your_strong_password@google-cloud-sql-ip:5432/comictraffic_db?sslmode=require

# Server-Side External Rating API Keys (Never exposed to the browser)
TMDB_API_KEY=your_tmdb_api_key_here
TMDB_API_URL=https://api.themoviedb.org/3

# Server-Side End-to-End Payload & Response Encryption Secrets
PAYLOAD_ENCRYPTION_KEY=replace_with_32_byte_aes_secret_in_vercel
PAYLOAD_HMAC_KEY=replace_with_32_byte_hmac_secret_in_vercel

# Server-Side JWT Authentication Secret
JWT_SIGNING_KEY=replace_with_32_byte_jwt_secret_in_vercel
